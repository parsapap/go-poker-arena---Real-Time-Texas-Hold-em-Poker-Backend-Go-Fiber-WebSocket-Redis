# ===========================================
# Go Poker Arena - Environment Configuration
# ===========================================

# Backend Environment Variables
PORT=8080
ENV=development
LOG_LEVEL=info

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=poker
POSTGRES_PASSWORD=poker123
POSTGRES_DB=poker_arena
AUTO_MIGRATE=true
DATABASE_URL=postgres://poker:poker123@localhost:5432/poker_arena?sslmode=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CORS - In development, set to * for WebSocket testing
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# API URL for Docker (used by frontend container)
API_URL=http://backend:8080

# Frontend Configuration (for local development)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Production URLs (uncomment and update for deployment)
# NEXT_PUBLIC_API_URL=https://your-backend.railway.app
# NEXT_PUBLIC_WS_URL=wss://your-backend.railway.app
